{
  "name": "ride",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "start:dev": "npx nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/api.ts",
    "test:dev": "npx jest test/api.test.ts --watch",
    "docker:start": "docker compose up -d",
    "docker:stop": "docker compose stop",
    "docker:clean": "docker compose rm -fsv",
    "db:update": "psql -h localhost -p 5432 -U postgres -d app -f ./scripts/update.sql"
  },
  "dependencies": {
    "@hapi/hapi": "^21.4.9",
    "@types/express": "^4.17.17",
    "@types/sinon": "^21.0.1",
    "axios": "^1.5.0",
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "jest": "^29.6.4",
    "nodemon": "^3.0.1",
    "pg-promise": "^11.5.4",
    "sinon": "^22.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/jest": "^30.0.0"
  }
}
